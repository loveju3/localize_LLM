# Copy to .env and populate when cloud services are provisioned.
DATABASE_URL=
APP_API_KEY=
WORKSPACE_ID=personal
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Include /v1; use an authenticated HTTPS endpoint.
VLLM_BASE_URL=
VLLM_API_KEY=
# Modal cold starts may need a longer timeout (select_backend.py sets 600).
LLM_TIMEOUT_SECONDS=180
EMBEDDING_MODEL=BAAI/bge-m3
# Resolve once, then share the exact value with every machine:
# python -m app.cli resolve-revision BAAI/bge-m3
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_TOKENS=2048
EMBEDDING_QUERY_PROMPT=
EMBEDDING_DOCUMENT_PROMPT=
HF_HOME=.cache/huggingface
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
CHUNK_CHARS=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
# Starting threshold only; calibrate with your own evaluation questions.
MIN_SIMILARITY=0.35
